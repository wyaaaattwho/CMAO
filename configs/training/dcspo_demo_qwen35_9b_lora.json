{
  "model": {
    "name": "Qwen/Qwen3.5-9B",
    "reference_name": "Qwen/Qwen3.5-9B",
    "trust_remote_code": true
  },
  "data": {
    "path": "outputs/eval/math500_base_qwen35_9b/scores.json",
    "limit": 200,
    "utility_field": "constant"
  },
  "dcspo": {
    "clip_range": 2.0,
    "normalize_by": "tokens"
  },
  "training": {
    "output_dir": "outputs/train/dcspo_demo_qwen35_9b_lora",
    "learning_rate": 2e-5,
    "weight_decay": 0.0,
    "max_steps": 200,
    "num_epochs": 1,
    "per_device_train_batch_size": 1,
    "gradient_accumulation_steps": 8,
    "max_length": 4096,
    "max_grad_norm": 1.0,
    "bf16": true,
    "gradient_checkpointing": true,
    "logging_steps": 1,
    "save_steps": 0,
    "seed": 42
  },
  "lora": {
    "enabled": true,
    "r": 16,
    "alpha": 32,
    "dropout": 0.05,
    "autocast_adapter_dtype": false,
    "target_modules": [
      "q_proj",
      "k_proj",
      "v_proj",
      "o_proj",
      "gate_proj",
      "up_proj",
      "down_proj"
    ]
  }
}
